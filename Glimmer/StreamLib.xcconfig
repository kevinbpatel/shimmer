// Single source of truth for the app version (MARKETING_VERSION +
// CURRENT_PROJECT_VERSION). Pulled in here so the Makefile's single
// `-xcconfig` flag supplies the version to the build.
#include "Version.xcconfig"

// Xcode build settings for the C libraries the Swift-native streaming engine
// links against (Homebrew OpenSSL + Opus). Applied via `xcodebuild -xcconfig`
// from the Makefile so the pbxproj stays portable (no absolute paths committed).
//
// Resolves at build time:
//   OPENSSL_PREFIX / OPUS_PREFIX = $(brew --prefix ...), injected by Makefile

// SRCROOT = repo root (directory containing Glimmer.xcodeproj).
GLIMMER_REPO_ROOT = $(SRCROOT)

// Repo root for our own headers (CHelpers.h, imported via the bridging header) +
// Homebrew OpenSSL + Opus headers.
HEADER_SEARCH_PATHS = $(inherited) $(GLIMMER_REPO_ROOT) $(OPENSSL_PREFIX)/include $(OPUS_PREFIX)/include

// Homebrew OpenSSL + Opus libs.
LIBRARY_SEARCH_PATHS = $(inherited) $(OPENSSL_PREFIX)/lib $(OPUS_PREFIX)/lib

// Link the C libraries into the APP (and its test bundle) only. This file is
// passed on the xcodebuild command line, so it applies to every target and
// OVERRIDES target-level settings - a per-target opt-out in the pbxproj can't
// win. Indirecting through $(PRODUCT_MODULE_NAME) keys the flags to the
// targets that need them: Glimmer / GlimmerTests get the libs, and the Login
// Helper (Shimmer_Login_Helper, AppKit + Foundation only) resolves to nothing.
// It used to inherit these and carried absolute /opt/homebrew dylib links that
// Hardened Runtime library validation refuses at launch (different Team ID),
// so the helper crashed in dyld every login and "Be ready at login" silently
// did nothing. embed-dylibs.sh only rewrites the main binary - by design; the
// helper must simply not link them.
STREAMLIB_LDFLAGS_Glimmer = -lssl -lcrypto -lz -lopus
STREAMLIB_LDFLAGS_GlimmerTests = -lssl -lcrypto -lz -lopus
OTHER_LDFLAGS = $(inherited) $(STREAMLIB_LDFLAGS_$(PRODUCT_MODULE_NAME))

// Apple Silicon only. Homebrew's openssl@3 / opus are arm64-only, so a universal
// (arm64 + x86_64) link fails on the x86_64 slice with undefined OpenSSL symbols.
// Pin arm64 so the Release build - which otherwise defaults to ARCHS_STANDARD
// (universal) - stays arm64-only, matching the shipped binaries. (The committed
// shared scheme doesn't carry the auto-scheme's run-destination arch narrowing.)
ARCHS = arm64

// Bridging header at repo root (where Xcode looks by convention).
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/Glimmer-Bridging-Header.h
