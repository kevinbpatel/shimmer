<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shimmer runs UNSANDBOXED. It was unsandboxed for a root Wi-Fi helper
	     that has since been removed; running it sandboxed again is untested
	     (raw HID, the bundled CLI and its state file would all need
	     entitlements). Stays Hardened Runtime. See docs/SECURITY.md. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Hardened Runtime: no JIT. -->
	<key>com.apple.security.cs.allow-jit</key>
	<false/>
</dict>
</plist>
